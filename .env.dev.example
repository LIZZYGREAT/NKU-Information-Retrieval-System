# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nku_search_dev

# ---------- Elasticsearch ----------
ES_HOST=http://127.0.0.1:9200
ES_INDEX_NAME=nku_web_index_dev

# ---------- Backend ----------
SECRET_KEY=change-me
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api

# Frontend is normally served on port 5500
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ---------- Query correction ----------
CORRECT_ENGINE_URL=http://127.0.0.1:8080

# ---------- Optional LLM semantic tagging ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

TAGGER_MODE=hybrid
TAGGER_MIN_CONFIDENCE=0.55
CRAWL_TAGGER_MODE=rule

BATCH_TAG_SIZE=8
BATCH_TAG_WORKERS=2
DEEPSEEK_CALL_INTERVAL=0.35
